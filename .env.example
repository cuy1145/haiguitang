# ============================================================================
# AI 海龟汤 · 本地配置模板
# 复制为 .env 后填写。.env 已被 .gitignore 排除，绝不能提交。
# 说明：留空的项都有安全默认值，缺失不会导致弱加密或静默降级。
# ============================================================================

# ---- 服务 ----
PORT=8787
HOST=127.0.0.1
# 仅本地开发用：挂载 /debug/* 接口（必须配合回环地址）。公网部署请置 0。
DEV_TOOLS=1
# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# ---- 主密钥（用于加密存储房主提交的 API Key）----
# 生成方式：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# 留空 => 自动禁用「房主自备 Key」功能（并明确提示），不会退化成明文或弱加密。
MASTER_KEY=

# ---- AI 提供方（站点内置额度；留空则使用内置模拟主持人，可离线试玩）----
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_MODEL=
AI_KEY=
# 单次调用超时（毫秒）与最大重试次数（不含首次）
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2

# ---- 站点备用额度的成本闸门（0 = 不限制）----
SITE_MONTHLY_CALL_CAP=2000
SITE_MONTHLY_COST_CAP=0
SITE_GRANT_BUDGET_CALLS=200
SITE_GRANT_MAX_PER_MATCH=2
SITE_GRANT_COOLDOWN_SEC=600

# ---- 数据 ----
DATA_DIR=data
# 启动时自动打开浏览器：1=开（默认），0=关
OPEN_BROWSER=1
